# Local configuration for llm-gc. Copy to .env and fill in your values; .env is git-ignored.
# It is read from the directory you run `llm-gc` in. A value left blank counts as not set.
#
# Settings that are not secret (ports, upstream, summary model, engine tunables) belong in
# llm-gc.toml instead, which is meant to be shared. Anything set here as LLM_GC_* beats the
# file, and a command-line flag beats both.

# LLM-GC's own credential, for its summary and fact calls (never a client's): an
# Anthropic API key from console.anthropic.com, or a key your organisation's gateway
# accepts. Sent as x-api-key.
ANTHROPIC_API_KEY=

# Or a bearer token, sent as Authorization: what a gateway in front of Anthropic
# often takes instead of a key. Either or both; each is sent when set.
ANTHROPIC_AUTH_TOKEN=

# Needed only when summaries go to OpenAI (LLM_GC_SUMMARY__PROVIDER=openai). Sent as a
# bearer token.
OPENAI_API_KEY=

# Optional overrides, shown with their defaults. Remove the leading # to use one.

# Log level for the application: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# LLM_GC_LOG_LEVEL=INFO

# Where client requests are forwarded, and where LLM-GC's own summary calls go: a
# gateway in front of Anthropic, for one.
# LLM_GC_UPSTREAM=https://api.anthropic.com

# Which vendor LLM-GC summarises with: anthropic or openai. Each reads its own credential.
# LLM_GC_SUMMARY__PROVIDER=anthropic

# The model it summarises with, named as the vendor (or a gateway in front of it) names
# it. Left out, the vendor's own default is used.
# LLM_GC_SUMMARY__MODEL=claude-sonnet-5

# The proxied model's input window in tokens; the recap's budget is a share of it. The
# default suits a 200k model: raise it only if every model you proxy has a larger window.
# Engine settings take a double underscore: LLM_GC_ENGINE__<NAME>.
# LLM_GC_ENGINE__CONTEXT_WINDOW=200000
