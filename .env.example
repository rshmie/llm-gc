# Environment configuration for llm-gc. Copy to .env and fill in your values.

# Log level for the application. Possible values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LLM_GC_LOG_LEVEL=INFO

# The language model to be used by the application. Possible values: claude-sonnet-4-6, gpt-4, claude-haiku-4.5, etc.
LLM_GC_MODEL=claude-sonnet-4-6

# Maximum number tokens in the context window of language model. Adjust based on your needs and the capabilities of the chosen model.
LLM_GC_MAX_TOKENS=128000

# LLM-GC's own credential, for its summary and fact calls (never a client's): an
# Anthropic API key from console.anthropic.com, or a key your organisation's gateway
# accepts. Sent as x-api-key.
ANTHROPIC_API_KEY=

# Or a bearer token, sent as Authorization: what a gateway in front of Anthropic
# often takes instead of a key. Either or both; each is sent when set.
ANTHROPIC_AUTH_TOKEN=